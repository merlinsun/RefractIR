fun @kernel(%x: tensor [2, 4] i32) : tensor [2, 4] i32 {
  let mut %rows: tensor [2] i32 = undef;
  let mut %expanded: tensor [2, 1] i32 = undef;
  let mut %out: tensor [2, 4] i32 = undef;
^entry:
  %rows = tensor sum %x, 1, drop;
  %expanded = tensor expand %rows, 1;
  %out = tensor broadcast %expanded, [2, 4];
  ret %out;
}
