(set-logic QF_NRAT)
(set-option :produce-models true)
(declare-const a Real)
(declare-const b Real)
(assert (or (= a (- 2)) (= a (- 1)) (= a 0) (= a 1) (= a 2) (= a 3)))
(assert (or (= b (- 2)) (= b (- 1)) (= b 0) (= b 1) (= b 2) (= b 3)))
(assert (> (/ (exp a) (+ (exp a) 3)) (/ 4 5)))
(assert (> (/ (exp b) (+ (exp b) 3)) (/ 4 5)))
(check-sat)
(get-value (a b))
