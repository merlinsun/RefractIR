(set-logic QF_NRAT)
(set-option :produce-models true)
(declare-const a Real)
(declare-const b Real)
(declare-const c Real)
(declare-const d Real)
(assert (or (= a (- 2)) (= a (- 1)) (= a 0) (= a 1) (= a 2) (= a 3)))
(assert (or (= b (- 2)) (= b (- 1)) (= b 0) (= b 1) (= b 2) (= b 3)))
(assert (or (= c (- 2)) (= c (- 1)) (= c 0) (= c 1) (= c 2) (= c 3)))
(assert (or (= d (- 2)) (= d (- 1)) (= d 0) (= d 1) (= d 2) (= d 3)))
(assert (> (/ (exp b) (+ (exp a) (exp b))) (/ 4 5)))
(assert (> (/ (exp c) (+ (exp c) (exp d))) (/ 4 5)))
(check-sat)
(get-value (a b c d))
